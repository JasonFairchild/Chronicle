{
  "env": {
    "GIT_PAGER": "cat",
    "PAGER": "cat"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git check-ignore:*)",
      "Bash(git range-diff:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git show-ref:*)",
      "Bash(git merge-base:*)",
      "Bash(git cat-file:*)",
      "Bash(git describe:*)",
      "Bash(git shortlog:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm ls:*)",
      "Bash(npm outdated:*)",
      "Bash(npm view:*)",
      "Bash(node --version)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(pwd)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(tree:*)",
      "Bash(sed:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(echo:*)",
      "Skill(update-config)"
    ],
    "deny": [
      "Bash(git -c:*)",
      "Bash(git --config-env:*)",
      "Bash(git -C:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(git --no-pager:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git rebase:*)",
      "Bash(git am:*)",
      "Bash(git submodule:*)",
      "Bash(git tag:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git update-ref:*)",
      "Bash(git gc:*)",
      "Bash(git prune:*)",
      "Bash(git reflog expire:*)",
      "Bash(git reflog delete:*)",
      "Bash(git rm:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -f -r:*)",
      "Bash(rm -f -R:*)",
      "Bash(rm --force --recursive:*)",
      "Bash(rm -f --recursive:*)",
      "Bash(wget:*)",
      "Bash(npm publish:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(git restore:*)",
      "Bash(git add:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git apply:*)",
      "Bash(git mv:*)",
      "Bash(git reflog:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(git merge:*)",
      "Bash(curl:*)",
      "Bash(rm:*)"
    ]
  }
}
