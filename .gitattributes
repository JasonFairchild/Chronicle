# Normalize line endings: LF in the repo and working tree on every OS.
# Matches Prettier's default (endOfLine: "lf") so the two don't fight.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
